# Optional Google Search Console HTML-tag verification token.
# Copy only the token from Google's content="..." value.
GOOGLE_SITE_VERIFICATION=

# Optional Supabase browser configuration. These are public project values,
# not service-role secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by the PDF-to-Word API route. Never expose this through
# a NEXT_PUBLIC_ variable or commit a real value to this file.
CLOUDCONVERT_API_KEY=

# Optional server-only HTTPS webhook that receives contact form JSON.
CONTACT_FORM_ENDPOINT=
