# Optional Google Search Console HTML-tag verification token.
# Copy only the token from Google's content="..." value.
GOOGLE_SITE_VERIFICATION=

# Optional Supabase browser configuration. Prefer the current publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Temporary fallback for projects still using Supabase's legacy public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL for the FastAPI service. Use the deployed Railway URL in
# production; do not add a trailing slash.
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000/api/v1
# Required by the scheduled 30-day saved-file cleanup. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Use a long random value. Add the same value in Vercel Project Settings → Environment Variables.
CRON_SECRET=
